{
  "name": "clipvault",
  "version": "1.0.0",
  "description": "ClipVault — Менеджер буфера обмена для macOS",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "preview": "electron scripts/preview.cjs",
    "build": "electron-builder --mac"
  },
  "author": "ClipVault",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^10.0.0",
    "menubar": "^9.5.3"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.clipvault.app",
    "productName": "ClipVault",
    "icon": "assets/icon.icns",
    "files": [
      "main.js",
      "preload.cjs",
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "ClipVault",
      "icon": "assets/icon.icns",
      "iconSize": 100,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 185,
          "type": "file"
        },
        {
          "x": 390,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    }
  }
}
